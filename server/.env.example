# Copy to server/.env (git-ignored) and fill in.
RQ_DEVICE_ID=box-01
# Same value as DEVICE_SECRET in firmware/include/secrets.h
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
RQ_DEVICE_SECRET=
# Generate with: python app.py hash-password
RQ_ADMIN_PASSWORD_HASH=
# Random string for signing dashboard session cookies
RQ_SECRET_KEY=
RQ_HOST=0.0.0.0
RQ_PORT=8080
# RQ_DB_PATH=riseq.db
